APP_ENV=development
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///instance/app.db
STORAGE_BACKEND=local

# Render + Supabase production values:
# DATABASE_URL=postgresql://...
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=encrypted-files
# S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=replace-with-server-side-access-key
# S3_SECRET_ACCESS_KEY=replace-with-server-side-secret-key
# S3_REGION=replace-with-project-region
# BEHIND_PROXY=1
